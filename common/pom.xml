<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.joborch</groupId>
        <artifactId>distributed-job-orchestration</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <packaging>jar</packaging>
    <name>Common — Shared Domain Model</name>

    <!--
        WHY no Spring Boot dependencies here?
        ========================================
        The common module is a pure Java library.
        It defines the shared vocabulary (enums, DTOs) that producer and worker
        both speak. If we added spring-boot-starter here, we'd be dragging
        Spring's auto-configuration classpath into common, which:
          1. Inflates the JAR size unnecessarily.
          2. Creates potential for auto-configuration side effects.
          3. Tightly couples a "shared vocabulary" library to a runtime framework.

        Common should be framework-agnostic. It's a domain library, not a service.
    -->
    <dependencies>
        <!--
            Jackson is needed so JobMessage can be serialized to JSON
            when published to RabbitMQ. We use Jackson annotations
            (e.g., @JsonProperty) to control the serialization contract.

            WHY Jackson and not a different serializer?
            Jackson is Spring AMQP's default MessageConverter when
            using Jackson2JsonMessageConverter. Using the same library
            in common avoids dual-serializer conflicts.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <!-- Needed to serialize/deserialize Java 8+ date/time types -->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                WHY we explicitly exclude spring-boot-maven-plugin here?
                ============================================================
                The parent POM (spring-boot-starter-parent) includes
                spring-boot-maven-plugin in pluginManagement. If a child module
                runs the 'package' phase without disabling this plugin,
                Maven will try to repackage the JAR as an executable Spring Boot JAR
                (with BOOT-INF/ structure).

                An executable Spring Boot JAR is NOT a valid library JAR.
                If producer tries to use common as a dependency, Maven will find
                the BOOT-INF structure and fail to locate classes.

                Solution: Skip the repackage goal for common.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
