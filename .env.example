# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, RABBITMQ credentials
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=joborch_db
POSTGRES_USER=joborch_user
POSTGRES_PASSWORD=change_me_in_production

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change_me_in_production

# ── Producer Service ──────────────────────────────────────────────────────────
PRODUCER_PORT=8080
PRODUCER_POOL_SIZE=10

# ── Worker Service ────────────────────────────────────────────────────────────
WORKER_PORT=8081
WORKER_CONCURRENCY=1
WORKER_MAX_CONCURRENCY=5

# ── Retry Configuration ───────────────────────────────────────────────────────
RETRY_DELAY_1_MS=5000
RETRY_DELAY_2_MS=30000
RETRY_DELAY_3_MS=120000

# ── Outbox Publisher ──────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000

# ── Scheduled Jobs ────────────────────────────────────────────────────────────
SCHEDULING_POLL_INTERVAL_MS=5000
